    },
    {
      "id": "claim_bffbc8f958b4497491ff59bd717cc16d",
      "statement": "CostTrackingMiddleware.after_model charges every model request completed since the previous checkpoint and after_agent drains requests (e.g. the ReliableRubric grading agent) that spent after the final model step; both hooks catch exceptions because each hook is its own graph node whose failure would fail the user's turn.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/cost_tracking.py#L2345-L2405",
          "version": "repo-lines-v1:sha256:196c96e73b92b723be57ce963c9e423ba4bb6e8b359ccb145a9c63f89659a7be:"
        }
      ]
    },
    {
      "id": "claim_cbf96d023a904c8dadabf3056827f178",
      "statement": "A nested (subagent) CostTrackingMiddleware zeroes its cost channel in before_agent, checkpoints local spend on a private channel, and transfers the completed delta through the `_session_cost_transfers` map (keyed by checkpoint scope with owner_scope and total) for the owning parent graph to checkpoint even when a sibling interrupts.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/cost_tracking.py#L2204-L2216",
          "version": "repo-lines-v1:sha256:4a8eb047d65150c3f069d035c1c1003a949a22b23cb2bde44c11f52711f81684:"
