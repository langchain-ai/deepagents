    },
    {
      "id": "claim_771d30e46bda44899664487392088914",
      "statement": "Shared ChannelExposure defaults to self, where from_self or configured operator IDs are admitted; allowlist admits configured conversation IDs or text glob patterns; open admits every message but configuration requires an explicit risk acknowledgement and logs the arbitrary-sender risk.",
