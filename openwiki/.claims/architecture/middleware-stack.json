  "claims": [
    {
      "id": "claim_50b7ad2956904bd0bdada52eb056f4ae",
      "statement": "Middleware overrides hooks such as wrap_model_call() that intercept every LLM request before it is sent, letting it filter tools, inject prompt context, transform history, and maintain typed cross-turn state.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/middleware/__init__.py#L15-L47",
          "version": "repo-lines-v1:sha256:1435c8ef4c404c3f7372b55681a6b4908cf36fa84021c40c84b05cf98dd713f7:"
        }
      ]
    },
    {
      "id": "claim_ff95e414dea94421b253811201c3e5d9",
      "statement": "A callable passed via tools= is only invoked after the model chooses to call it and cannot rewrite the tool list or prompt before the model call, whereas middleware runs before every model call; caller tools= are additive and never remove a built-in.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/graph.py#L335-L345",
          "version": "repo-lines-v1:sha256:0a32ed8d78c7b12d09bfd8ef8a8072918191a7aff49727cea163b52824e2f6ba:"
