    {
      "id": "claim_a19908f3a61742b19635db8c15d6f6cf",
      "statement": "The rubric grader can emit satisfied, needs_revision, or failed verdicts, and the middleware synthesizes two additional terminal statuses (max_iterations_reached and grader_error) that the grader cannot emit; only needs_revision continues the loop.",
      "evidence": [
