CacheExpiryScreen {
    align: center middle;
}

CacheExpiryScreen > Vertical {
    width: 72;
    max-width: 90%;
    height: auto;
    background: $surface;
    border: solid $warning;
    padding: 1 2;
}

CacheExpiryScreen Static {
    height: auto;
}

CacheExpiryScreen .title {
    text-style: bold;
    color: $warning;
    text-align: center;
    margin-bottom: 1;
}

CacheExpiryScreen .body {
    color: $text;
    margin-bottom: 1;
}

CacheExpiryScreen .choices,
CacheExpiryScreen .hint {
    color: $text-muted;
    text-style: italic;
    text-align: center;
}

CacheExpiryScreen .hint {
    margin-top: 1;
}
