    {
      "id": "claim_a3fd845d36cb4ba9bbc7fb1879c3a9ac",
      "statement": "Deep Agents separately converts filesystem interrupt permissions into HumanInTheLoopMiddleware routing: exact tools use first-match resolution, bulk tools conservatively interrupt on intersecting subtrees and bypass-prone omitted, current-directory, absolute-glob, or parent-traversing patterns, user interrupt_on entries override generated entries by tool name, and approved or edited calls still re-enter tool-level denial enforcement.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/graph.py#L186-L202",
