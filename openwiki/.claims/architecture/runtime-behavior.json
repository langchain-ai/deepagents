      "id": "claim_40b27e72b5c8466491476f2b545b4c2e",
      "statement": "Server runtime construction returns the compiled agent, its CompositeBackend, and an offload operation derived from that same backend; process construction is lock-protected and cached, while workspace runtimes are a lock-protected LRU of at most 32 entries keyed by workspace and runtime identity, reject configuration-policy drift, and prevent a process-wide sandbox from being shared by different workspaces.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/server_graph.py",
          "version": "repo-file-v1:sha256:c905286d6ce800d598f501ef43a48f7b412c24a96ec8d2afe2ec82bebc2f7e2e"
        }
      ]
    },
