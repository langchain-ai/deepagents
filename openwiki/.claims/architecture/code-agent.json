    {
      "id": "claim_ecc9ec98b14344b6ba8f3d3b0e9611b7",
      "statement": "dcode caches server-owned resources by lifetime and workspace: the no-context factory builds one lock-protected process runtime, while context-bound executions use a shared-lock workspace runtime LRU keyed by persisted resource key and capped at 32; caching prevents duplicate MCP discovery, sandbox creation, and atexit handler registration for a constructed process runtime.",
      "evidence": [
