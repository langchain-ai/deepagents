    {
      "id": "claim_6c6cdaebbd8d408fba9a470d54419fcf",
      "statement": "DaytonaSandbox subclasses BaseSandbox and implements execute() by running the command asynchronously in a per-command Daytona session, polling the session command status until an exit code appears (polling delay controlled by sync_polling_interval) and then collecting session logs, returning exit code 124 on timeout; timeout=0 means wait indefinitely.",
      "evidence": [
        {
          "resource": "repo://libs/partners/daytona/langchain_daytona/sandbox.py#L23-L134",
          "version": "repo-lines-v1:sha256:f1adf10fb3d289497ca9873187cad7a0093cded10f8675ad459f6ed89be111db:"
        }
      ]
    },
    {
      "id": "claim_96fc759269844e18af407eea57d5bcd3",
      "statement": "ModalSandbox subclasses BaseSandbox and implements execute() via sandbox.exec(\"bash\", \"-c\", command, timeout=...), combining stdout and stderr, with file transfer using the Modal sandbox open()/read()/write() and id set to the Modal object_id; timeout=0 means wait indefinitely.",
      "evidence": [
