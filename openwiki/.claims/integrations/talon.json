        }
      ]
    },
    {
      "id": "claim_26782ce0644d4d5381388d5d37469b3f",
      "statement": "Talon captures selected model and effort at turn creation, and `DeepAgentRuntime` validates and scopes model and effort settings through context variables that are reset when the turn exits, so later selections do not alter an active turn.",
