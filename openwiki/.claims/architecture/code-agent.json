        }
      ]
    },
    {
      "id": "claim_de62d39b701c4d00b399b22f1f4a7785",
      "statement": "A request follows the same shape in both modes: the client receives input, sends it to the server, the server runs the agent and streams events back, the client renders them and collects any needed human response, and session state is preserved so the conversation can continue later.",
      "evidence": [
        {
          "resource": "repo://libs/code/ARCHITECTURE.md#L28-L38",
          "version": "repo-lines-v1:sha256:559591bbe929cc7dd5921d771dc6e3e16e0d041d9dbaeeb5a7e0587d327c6331:"
        }
      ]
    },
    {
      "id": "claim_eb976e970cb840bba02a567522a1433d",
      "statement": "Headless (non-interactive) mode reuses the same agent runtime and RemoteAgent client, running a single user task inside the same `langgraph dev` server subprocess but swapping the terminal interface for machine-friendly stdout streaming, with an optional quiet mode that leaves only the agent's response text.",
      "evidence": [
        {
