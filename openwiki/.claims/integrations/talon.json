  "claims": [
    {
      "id": "claim_5a4ee44bdfc94fe0b737b4c36af91fa8",
      "statement": "The shared chat-command registry supplies host parsing, `/help`, and platform advertisements where supported; `/reset-all-history` and `/pair` are hidden but remain executable, while `/model` is visible.",
      "evidence": [
        {
          "resource": "repo://libs/talon/deepagents_talon/commands.py",
          "version": "repo-file-v1:sha256:df0a3647739b4e879e20367c8d0540ecbf21bb700884e08770f3c79da43e6157"
        }
      ]
    },
    {
      "id": "claim_d022e827114343718d8057a82af905f3",
      "statement": "The CLI attaches WhatsApp, Telegram, Discord, and Slack adapters from explicit flags or corresponding enabled environment variables; with no model it uses the echo runtime, while a model opens configured checkpoint and history stores, loads MCP tools, and builds the Deep Agents runtime.",
      "evidence": [
        {
          "resource": "repo://libs/talon/deepagents_talon/__main__.py#L296-L394",
          "version": "repo-lines-v1:sha256:05f65931607b5f9cd6401db02edc5a0b9718b3e5a5f188881409e4bd281cc235:"
        }
      ]
    },
    {
      "id": "claim_b0b68b4320aa4b448a0433019d19ae51",
      "statement": "Channel exposure is shared as `self`, `allowlist`, or explicitly acknowledged `open`; open exposure permits arbitrary senders to trigger the agent with operator credentials and local-host access.",
