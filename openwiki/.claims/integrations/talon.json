    {
      "id": "claim_2b0cdd480c134f1c92ff3abc1b414197",
      "statement": "`DeepAgentRuntime.invoke()` refreshes runtime tools, snapshots approval policy and may rebuild its graph, scopes request-specific context including progress and history around invocation, resets its context variables in `finally`, and returns background-result IDs with the final text after acknowledging their consumption.",
      "evidence": [
        {
          "resource": "repo://libs/talon/deepagents_talon/runtime.py#L726-L811",
