    {
      "id": "claim_0b6b2fddf56d4b888a2791d94c40f924",
      "statement": "ACP only supports fixed-decision permission prompts, so a free-form LangGraph interrupt() whose value is not a permission-style dict is rejected with a RequestError instructing the agent to use HumanInTheLoopMiddleware-style interrupts.",
      "evidence": [
        {
          "resource": "repo://libs/acp/deepagents_acp/server.py#L972-L994",
          "version": "repo-lines-v1:sha256:9b6ff78da670cc93e2785f9cd4f92de998e94a0dc3a0e0ee72a9afddb42b4e39:"
        }
