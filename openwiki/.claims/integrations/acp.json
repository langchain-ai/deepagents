        }
      ]
    },
    {
      "id": "claim_d008a79f642940099451e0f14eda90eb",
      "statement": "new_session allocates a session id, records the editor working directory (cwd) and any MCP servers, and returns mode/model selectors as session config options when modes or models are configured.",
