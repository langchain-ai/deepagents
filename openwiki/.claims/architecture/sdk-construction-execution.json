    {
      "id": "claim_80c51fd355d64f1fad66b7a59a46eb8c",
      "statement": "The compiled graph returned by create_agent is wrapped with a tail .with_config that sets recursion_limit to 9999 and attaches Deep Agents metadata (ls_integration deepagents, the deepagents version under lc_versions, and lc_agent_name).",
