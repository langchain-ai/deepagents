diff --git a/libs/switchyard/tests/unit_tests/test_conversion.py b/libs/switchyard/tests/unit_tests/test_conversion.py
index a8406d9..b674814 100644
--- a/libs/switchyard/tests/unit_tests/test_conversion.py
+++ b/libs/switchyard/tests/unit_tests/test_conversion.py
@@ -266,0 +267 @@ def test_neutral_request_becomes_target_messages_tools_and_options() -> None:
+    assert messages[2].content == []
@@ -433,0 +435,44 @@ def test_neutral_response_becomes_ai_message_with_decision_trace() -> None:
+def test_neutral_tool_response_keeps_tool_calls_out_of_message_content() -> None:
+    response: dict[str, Any] = {
+        "id": "response-tool",
+        "model": "provider-model",
+        "outputs": [
+            {
+                "role": "assistant",
+                "content": [
+                    {"type": "text", "text": "Checking."},
+                    {
+                        "type": "tool_call",
+                        "id": "call-tool",
+                        "name": "lookup",
+                        "arguments": {"query": "switchyard"},
+                    },
+                ],
+                "stop_reason": "tool_use",
+            }
+        ],
+        "usage": {},
+    }
+
+    message = ai_message_from_response(response, [])
+
+    assert message.content == [{"type": "text", "text": "Checking."}]
+    assert message.tool_calls == [
+        {
+            "id": "call-tool",
+            "name": "lookup",
+            "args": {"query": "switchyard"},
+            "type": "tool_call",
+        }
+    ]
+    assert message.content_blocks == [
+        {"type": "text", "text": "Checking."},
+        {
+            "type": "tool_call",
+            "id": "call-tool",
+            "name": "lookup",
+            "args": {"query": "switchyard"},
+        },
+    ]
+
+
