# Opus 4.8 (strong) escalating from Nemotron 3.5 Nano (weak).
#
# The widest capability gap available. On the pytest suite this pairing would be
# pointless — Opus and GLM tie there, so the expensive tier buys nothing. On
# harbor-index the tasks are hard enough that Opus may genuinely separate, which
# is the condition escalation needs and the one the pytest suite never met.
#
# Nano speaks OpenAI Chat, Opus speaks Anthropic Messages, the client speaks
# OpenAI Chat — Switchyard translates across all three.

schema_version = 1

[llm_clients.nvidia]
format = "openai_chat"
base_url = "${SY_NANO_BASE_URL}"
api_key_env = "${SY_NANO_KEY_ENV}"

[llm_clients.strong_upstream]
format = "anthropic_messages"
base_url = "${SY_STRONG_BASE_URL}"
api_key_env = "${SY_STRONG_KEY_ENV}"

[llm_clients.judge_upstream]
format = "openai_chat"
base_url = "${SY_JUDGE_BASE_URL}"
api_key_env = "${SY_JUDGE_KEY_ENV}"

[targets.weak]
id = "${SY_NANO_ID}"
llm_client = "nvidia"
extra_body = { chat_template_kwargs = { enable_thinking = ${SY_NANO_THINKING} } }

[targets.strong]
id = "${SY_STRONG_ID}"
llm_client = "strong_upstream"

[targets.judge]
id = "${SY_JUDGE_ID}"
llm_client = "judge_upstream"

[routes.switchyard]
id = "switchyard"
type = "llm_classifier"
mode = "escalation"
classifier_target = "judge"
strong_target = "strong"
weak_target = "weak"

[routes.switchyard.escalation]
confirmations = ${SY_CONFIRMATIONS}
recent_turn_window = ${SY_RECENT_TURN_WINDOW}
window_message_chars = ${SY_WINDOW_MESSAGE_CHARS}
