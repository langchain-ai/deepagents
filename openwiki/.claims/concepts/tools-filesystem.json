          "version": "repo-lines-v1:sha256:3c2f769f56f6f58f879eae1bedb25816cb5f1736a76aba6d4b4928346fb3723a:"
        }
      ]
    },
    {
      "id": "claim_17ba9a5788c846d382f6805e338093a4",
      "statement": "_ToolExclusionMiddleware removes a profile's excluded tools from the model request in wrap_model_call and also rejects any call naming an excluded tool at the tool-call boundary with an 'is not available' error ToolMessage, because the executor still has the tool registered and dispatches on the emitted name.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/middleware/_tool_exclusion.py#L34-L101",
          "version": "repo-lines-v1:sha256:cae39d9913e8be6111d94c95fd6ed44201b074f75958e4df481cc1187f5f3345:"
        }
      ]
    },
    {
      "id": "claim_013d03f493b44ba0874f9a4368295a27",
      "statement": "_ToolExclusionMiddleware is wired into the graph only when the resolved profile has non-empty excluded_tools, and is appended after custom middleware so excluded tool names are stripped last and cannot be restored by a custom wrap_model_call.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/graph.py#L716-L718",
          "version": "repo-lines-v1:sha256:9ecbc063359ef19fe954abd51248256ae3ceda47efb3229b0ac5a513b7fe9bfa:"
