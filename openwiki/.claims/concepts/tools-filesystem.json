    {
      "id": "claim_587ccb89a36444e0a90f4cf74c225448",
      "statement": "Because FilesystemMiddleware omits disallowed filesystem tools from the bound node entirely, the catalog forwards the allowlist to narrow enumeration and keeps a defensive backstop that logs loudly and returns the unfiltered list if a disallowed filesystem tool leaks through, rather than scrubbing the evidence that enforcement failed.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/tool_catalog.py#L258-L284",
          "version": "repo-lines-v1:sha256:6364371e14131dc9245019ef55cbc0fde3e7cbe903ed34343012f1a1b8b992f1:"
        }
