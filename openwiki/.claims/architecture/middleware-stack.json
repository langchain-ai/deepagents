        }
      ]
    },
    {
      "id": "claim_bc674aacf0874840a042084e9e86b93b",
      "statement": "The main-agent stack is composed in three bands: base scaffolding is appended first, caller middleware from the middleware= param is spliced in the middle, and profile/tail middleware is appended last.",
