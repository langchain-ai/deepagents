          "version": "repo-file-v1:sha256:8b32157d05bc14682bedae0102114894187d1e04f043ea8e6f20401ecccd57ec"
        }
      ]
    },
    {
      "id": "claim_5839d227cad2440888ae673537699096",
      "statement": "Provider-profile resolution merges an exact model profile over its provider profile, chains pre-initialization hooks and dynamic factories base first, and lets factory output override static profile kwargs while caller kwargs retain final precedence.",
