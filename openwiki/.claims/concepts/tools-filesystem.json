    {
      "id": "claim_f9ad22a912104bf39549fc0dc5a10c2a",
      "statement": "Oversized tool results are evicted to the filesystem under the artifacts root, except for tools that truncate their own output or return minimal confirmations (ls, glob, grep, read_file, edit_file, write_file, delete), which are excluded from eviction.",
