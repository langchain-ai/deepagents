    {
      "id": "claim_6a5e070fb73c43048b9038d64fce25b8",
      "statement": "prepare_operation_cost prices a server operation's recorded side-model calls without committing them, returning a PreparedOperationCost whose update must be persisted atomically with the operation state or rolled back; a zero-delta prepare still consumes its records and must roll back if abandoned.",
      "evidence": [
