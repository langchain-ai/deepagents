  "claims": [
    {
      "id": "claim_6bdfb8742f1343cf8ba28d8db535656f",
      "statement": "Talon's `BackgroundSubagents` detaches local `task` and remote `start_async_task` calls for ordinary conversational turns into owner-scoped in-memory jobs, blocks nested delegation and approvals in workers, enforces job and concurrency limits, and exposes only a bounded text result to the owning conversation.",
      "evidence": [
        {
          "resource": "repo://libs/talon/deepagents_talon/background.py",
          "version": "repo-file-v1:sha256:ebf21e43a62484b40431357fafb08835e22200d0768ba7472c2942fee79fb210"
        },
        {
          "resource": "repo://libs/talon/tests/unit_tests/test_background.py",
          "version": "repo-file-v1:sha256:859d7c011052bd81b49f64c51f07d64a6098b1e79791ecebd8998ae3b979482b"
        }
      ]
    },
    {
      "id": "claim_7fc78df2964e46a8ae9ae1919d50210d",
      "statement": "Talon runs subagent delegation inline during scheduled turns because no later conversational turn can consume a detached result; inline calls leave no job, serializes failure or timeout as sanitized error output, queues fan-out beyond the inline concurrency ceiling, and keeps recursion blocked.",
      "evidence": [
        {
          "resource": "repo://libs/talon/deepagents_talon/background.py",
          "version": "repo-file-v1:sha256:ebf21e43a62484b40431357fafb08835e22200d0768ba7472c2942fee79fb210"
