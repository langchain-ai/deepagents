    {
      "id": "claim_3f6e4d8c4f6f470a94669778d16a96b1",
      "statement": "`create_deep_agent` separates declarative and compiled synchronous subagents from `AsyncSubAgent` specs, adds a default synchronous `general-purpose` worker unless the harness profile disables or replaces it, and installs the synchronous `task` middleware and asynchronous task middleware independently.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/graph.py",
          "version": "repo-file-v1:sha256:3826c92c9613a30d898d3fb4fb76ab49a6af0537b5ef74ec9e7340673f7f2261"
        }
      ]
    },
    {
      "id": "claim_6572cea871b84b438b407966aa6125f9",
      "statement": "A synchronous declarative subagent is isolated by default: it receives a new task message and state with messages, todos, structured response, skill metadata, pinned skills, disclosure metadata, fork marker, and private fields excluded; explicit child permissions or `interrupt_on` replace inherited values, while omitted values inherit the parent configuration.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/graph.py",
          "version": "repo-file-v1:sha256:3826c92c9613a30d898d3fb4fb76ab49a6af0537b5ef74ec9e7340673f7f2261"
        },
