    {
      "id": "claim_b86cac28728a4ce3955220f03bab383b",
      "statement": "When the agent graph interrupts for a human-in-the-loop decision, the server calls the client's request_permission with approve, reject, and 'always allow' options and maps the client's selected option back into a resume decision.",
      "evidence": [
        {
          "resource": "repo://libs/acp/deepagents_acp/server.py#L1201-L1274",
          "version": "repo-lines-v1:sha256:844d853927f320797634e57dad5647ed06ef9759dfa7bc51a882710d6a2c60c5:"
        }
      ]
    },
    {
      "id": "claim_2cc01c829105403a9e90543b0ae3fa29",
      "statement": "'Always allow' approvals record the tool (or shell command type) in a per-session allowed-command-types set so future matching calls are auto-approved for that session.",
      "evidence": [
        {
          "resource": "repo://libs/acp/deepagents_acp/server.py#L1234-L1246",
