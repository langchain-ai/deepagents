  "claims": [
    {
      "id": "claim_f69e854889dc465d8c71bec1dd14bbd5",
      "statement": "dcode create_model applies its allowlist after provider inference but before credential bridging, provider profiles, and provider imports; blocked models therefore cannot cause those side effects.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/config.py",
          "version": "repo-file-v1:sha256:d1405d113837b154df99b7ea7c6c781b13c615502782aa73194060af0059b246"
        }
      ]
    },
    {
      "id": "claim_9f9f63740c054841b9eb29c7d35de7ed",
      "statement": "The SDK exposes orthogonal beta profile registries: ProviderProfile controls string-model construction through init_chat_model, while HarnessProfile controls prompt, tools, middleware, and default-subagent behavior after model construction; both accept provider or provider:model keys and registration layers rather than replaces existing settings.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/profiles/__init__.py",
          "version": "repo-file-v1:sha256:8b32157d05bc14682bedae0102114894187d1e04f043ea8e6f20401ecccd57ec"
        }
      ]
    },
    {
      "id": "claim_5839d227cad2440888ae673537699096",
      "statement": "Provider-profile resolution merges an exact model profile over its provider profile, chains pre-initialization hooks and dynamic factories base first, and lets factory output override static profile kwargs while caller kwargs retain final precedence.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/profiles/provider/provider_profiles.py",
          "version": "repo-file-v1:sha256:43b55f1b02951ad37e728563ce1c12341310282dc3efc28ab6f4606dcd29a1ba"
        }
      ]
    },
    {
      "id": "claim_e5cda20535d44f86a778a01be64adc2d",
      "statement": "Harness-profile lookup selects an exact spec before provider fallback and merges model-level and provider-level fields; create_deep_agent resolves this profile for the main model and each declarative subagent before applying prompt, tool-description, and middleware changes.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/graph.py",
          "version": "repo-file-v1:sha256:d266ce645cbc773854d6b086049a597dd2accb70461e6545f61d6076c43310f0"
        }
      ]
    },
    {
      "id": "claim_f82a12510ac843b9a6bbbaf9c6f52d47",
      "statement": "Profile bootstrap is lazy, thread-coordinated, and one-time: built-ins load by direct imports, then third-party provider and harness entry-point hooks layer on top; broken built-ins fail bootstrap while broken third-party plugins are logged and skipped.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/profiles/_builtin_profiles.py",
          "version": "repo-file-v1:sha256:005a91e7fc4ca6b21220673dd9d02d6686bf63e1e4f1102d124b01f96886efcf"
        }
      ]
    },
    {
      "id": "claim_ce6d35b5ce22424784007b768910fbc2",
      "statement": "SDK resolve_model applies ProviderProfile construction behavior only to string specifications and returns an existing BaseChatModel unchanged; focused tests cover both pass-through and profile-derived kwargs for string resolution.",
