    {
      "id": "claim_85b8441040ee49a8a05a50dd857b688f",
      "statement": "ReadResult.__post_init__ enforces pagination invariants at construction: the start_line/end_line window is co-present and runs forward, total_lines is at least end_line, and next_offset must equal end_line so a backend cannot emit a resume offset that skips unshown lines.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/backends/protocol.py#L234-L274",
          "version": "repo-lines-v1:sha256:5145f478a112d3bae083f273b126ef409b77418ed548a56e22b9387160ac0e62:"
        }
      ]
    },
    {
      "id": "claim_0ba0c3ee053e43a9be358adcd89e1d1c",
      "statement": "Every sync backend method has an async twin; base async methods wrap the sync call with asyncio.to_thread, and agrep additionally bounds the wait with asyncio.wait_for(timeout=ASYNC_GREP_TIMEOUT) and forwards max_count only when the concrete grep accepts it, trimming afterward with _apply_grep_max_count.",
