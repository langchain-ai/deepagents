        }
      ]
    },
    {
      "id": "claim_ecb659627e364bf09a6ba51f60df71dd",
      "statement": "Merging provider profiles is additive per field: init_kwargs merge with override winning per key, pre_init callables chain (base then override), and both init_kwargs_factory callables run at every resolution with their outputs merged (override wins).",
