    {
      "id": "claim_d1e0604937fc42489e066f3921c00ca3",
      "statement": "estimate_cost forwards LangChain's inclusive input_tokens plus cache, audio, and reasoning detail buckets so genai-prices subtracts each bucket from its container before applying rates; only buckets the matched model actually prices are broken out and tokens in unpriced buckets stay in the ordinary input/output total.",
