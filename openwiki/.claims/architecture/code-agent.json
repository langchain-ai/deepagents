          "version": "repo-lines-v1:sha256:3ff8849b00740bc3934773f2c85cde498ef7c8e1034e6e8e19824b593921cb66:"
        }
      ]
    },
    {
      "id": "claim_d1a0baa48df34724b733da1ce6c5deb7",
      "statement": "The client and server share a single ServerConfig dataclass: the app writes config with ServerConfig.to_env() and the server subprocess reconstructs it with the inverse ServerConfig.from_env(), keeping the variable set, serialization, and defaults defined in one place.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/_server_config.py#L2-L9",
          "version": "repo-lines-v1:sha256:2e37fe5a7a309327403bb2c27cab4e9a68ab93f44f0f55326d523b80284d4797:"
