    {
      "id": "claim_5c652d88b09a40ad86fc44b4d01d6c6c",
      "statement": "Interactive and headless clients start a temporary, ephemeral-port LangGraph runtime, wait for the `agent` graph, bind the resolved workspace, and clean up the server if startup fails or is cancelled before handoff.",
