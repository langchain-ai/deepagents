    {
      "id": "claim_2e4214dd9267492fbd1dad2b87f1ddce",
      "statement": "The ranked resolution engine is intentionally unaware of the manifest, UI, model, theme, environment, or filesystem; providers coerce their own domains into Found, Unset, or Invalid results and provenance and health inside the engine use only numeric ranks.",
