    {
      "id": "claim_81df4e8140eb47cc9bf1856f91681fd3",
      "statement": "dcode creates models only after policy validation, layers provider and per-model defaults with stored credentials and SDK provider profiles before runtime kwargs, and stamps the concrete model with the provider-specific retry budget used after runtime model switching.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/config.py",
          "version": "repo-file-v1:sha256:d1405d113837b154df99b7ea7c6c781b13c615502782aa73194060af0059b246"
        }
      ]
    },
    {
      "id": "claim_834ca636dfce490483a35b9af8d6e8b7",
      "statement": "dcode disables recognized provider SDK retry loops, stores the selected retry budget on each constructed model, and its model-node middleware uses that per-request budget so runtime model switches do not multiply retry attempts.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/config.py",
          "version": "repo-file-v1:sha256:d1405d113837b154df99b7ea7c6c781b13c615502782aa73194060af0059b246"
