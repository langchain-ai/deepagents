    {
      "id": "claim_f68f8b1a15f44cd9b07392ed52bda256",
      "statement": "On the first successful genai-prices import a single daemon-thread updater starts, fetching upstream data.json hourly and installing it via set_custom_snapshot; it is suppressed by DEEPAGENTS_CODE_PRICES_AUTO_UPDATE=0, [update].prices_auto_update=false, or DEEPAGENTS_CODE_OFFLINE, and a failed fetch leaves the previously installed snapshot in place.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/cost_tracking.py#L501-L563",
          "version": "repo-lines-v1:sha256:0cf3d1b997fe12b2647c56f88f8cf89f3e79f77f9fcfe0a98b8e6fd65e9674ac:"
