    {
      "id": "claim_5acf32f81a9a46dba1aa132ede1591ce",
      "statement": "RubricMiddleware invokes a separate grader sub-agent each time the agent would otherwise finish; a needs_revision verdict injects feedback as a HumanMessage and resumes the loop, repeating until satisfied, failed, or max_iterations is reached. It is one of the largest middleware modules.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/middleware/rubric.py#L2-L11",
          "version": "repo-lines-v1:sha256:70caefb4044752aa0abbafee47e5b3b94d0d2b8667690a8ed3be2f349979ff42:"
