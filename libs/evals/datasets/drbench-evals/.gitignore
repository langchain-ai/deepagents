# Per-task document corpus (~87 MB across the dataset) is fetched from the pinned
# upstream ServiceNow/drbench tree via
# `python -m harbor_adapters.drbench.main --populate <dir>`.
*/environment/files/

# The files below are byte-identical across every task, so they are single-sourced
# (harbor_adapters/drbench/templates/) and regenerated by the same `--populate` step.
# Only tests/case.json (the per-task question + ground-truth insights) is committed.
*/environment/extract_text.py
*/tests/test.sh
*/tests/judge.py
