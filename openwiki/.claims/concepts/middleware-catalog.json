    {
      "id": "claim_d3c0b63bcdd446b9b1fe8e28af20eec7",
      "statement": "The deepagents.middleware package re-exports its public middleware classes and supporting types for filesystem, summarization, skills, subagents, async subagents, memory, rubric, and unsupported content from its __init__.py, defining the surface consumers import from deepagents.middleware.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/middleware/__init__.py",
          "version": "repo-file-v1:sha256:89d872bd1fe769203bf681a9ff6a8a207466ec4198816efd587e53a1666614ce"
        }
      ]
    },
    {
      "id": "claim_408faefac079476e9300895e10e35bbe",
      "statement": "Middleware subclasses AgentMiddleware and overrides hooks such as wrap_model_call() that intercept every LLM request before it is sent, letting it filter tools, inject system-prompt context, transform messages, and maintain cross-turn state — capabilities a plain tools= callable (invoked only after the model calls it) cannot provide.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/middleware/__init__.py",
          "version": "repo-file-v1:sha256:89d872bd1fe769203bf681a9ff6a8a207466ec4198816efd587e53a1666614ce"
        }
      ]
    },
    {
      "id": "claim_aaa19dacb4e7417ea2d5254dc6f435e2",
      "statement": "FilesystemMiddleware builds an allowlisted filesystem tool set from ls, read_file, write_file, edit_file, delete, glob, grep, and execute; read_file is required in an explicit allowlist, while execute and delete remain subject to backend capability checks.",
