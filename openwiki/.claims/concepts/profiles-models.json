    {
      "id": "claim_6f6546b40bc64c368233653ec3adf7a6",
      "statement": "apply_provider_profile composes lookup, pre_init invocation, and kwargs merging: it returns a fresh dict combining init_kwargs, init_kwargs_factory() output, and caller-supplied kwargs, with the factory winning over static kwargs and caller kwargs winning over both; when no profile matches it returns the caller kwargs unchanged.",
      "evidence": [
        {
