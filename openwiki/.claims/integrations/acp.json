        {
          "resource": "repo://libs/acp/deepagents_acp/server.py#L194-L205",
          "version": "repo-lines-v1:sha256:2a6de86e537312c2f79f25c38ac330daa82eb664ea125ac4a8b0f88cd943b164:"
