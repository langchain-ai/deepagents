    {
      "id": "claim_93b2dc2760c84ea69599be991b0fbf2d",
      "statement": "Description overrides are applied to caller tools without mutating caller-owned objects: dict tools and BaseTool instances are copied and rewritten, while plain callables are returned unchanged.",
