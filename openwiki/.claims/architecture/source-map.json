        }
      ]
    },
    {
      "id": "claim_0c2fbedf5d4c47f6a24f2e23acf08248",
      "statement": "graph.py is the SDK assembly point: create_deep_agent() resolves the model and profile, resolves the backend, assembles the main-agent middleware stack, builds default and caller subagents, composes the system prompt, and delegates to LangChain's create_agent().",
