        }
      ]
    },
    {
      "id": "claim_b8c0ccc521a3427387f6496b913a2b7b",
      "statement": "A bump-worthy change that also modifies lockfiles or real files in another managed component can create a release PR per touched component; the release scope check blocks lockfile-only and multi-component fan-out unless allow-lockfile-release acknowledges it, without preventing the resulting releases.",
      "evidence": [
        {
          "resource": "repo://.github/RELEASING.md#L703-L727",
          "version": "repo-lines-v1:sha256:fddebe8617c7e46c48b515d5eb953b5e4b57b7f1a70aa43f72064bcc90988dc0:"
