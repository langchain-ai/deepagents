    "owner": "client",
    "plain_output_policy": "ignore"
  },
  "PostToolUse": {
    "aggregation_policy": "feedback_and_context",
    "default_timeout_seconds": 600.0,
    "exit_code_policy": "feedback",
    "matcher_field": "tool_name",
    "owner": "server",
    "plain_output_policy": "ignore"
  },
  "PreCompact": {
    "aggregation_policy": "side_effect",
    "default_timeout_seconds": 600.0,
    "exit_code_policy": "block",
    "matcher_field": "trigger",
    "owner": "server",
    "plain_output_policy": "ignore"
  },
  "PreToolUse": {
    "aggregation_policy": "permission",
    "default_timeout_seconds": 600.0,
    "exit_code_policy": "deny",
    "matcher_field": "tool_name",
    "owner": "server",
    "plain_output_policy": "ignore"
  },
  "SessionEnd": {
    "aggregation_policy": "side_effect",
    "default_timeout_seconds": 600.0,
    "exit_code_policy": "diagnose",
    "matcher_field": "cause",
    "owner": "client",
    "plain_output_policy": "ignore"
