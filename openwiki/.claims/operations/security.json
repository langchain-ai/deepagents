    {
      "id": "claim_a18b9fee72b44b57b10acbb054dee690",
      "statement": "dcode treats sandbox backends (Daytona, LangSmith, Modal, Runloop, AgentCore) as trusted third-party services whose internals are out of scope; the runtime's responsibility ends at constructing and dispatching requests, and sandbox mode requires an explicit --sandbox opt-in.",
      "evidence": [
        {
          "resource": "repo://libs/code/THREAT_MODEL.md#L159-L159",
          "version": "repo-lines-v1:sha256:e87f0872b19f299def8852528a2981fe3124ca331fbb3b14cdfaf2609d6f6d82:"
