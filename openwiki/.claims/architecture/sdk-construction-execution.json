    {
      "id": "claim_d02cdaa2d27b48fdb74b8ca50e36ddf2",
      "statement": "The main-agent middleware stack is assembled in a fixed core order (optional Skills, Filesystem, SubAgent when inline subagents exist, summarization, PatchToolCalls, optional AsyncSubAgent), then a tail (profile extra middleware, prompt caching, optional Memory, optional HumanInTheLoop) is appended, with caller middleware spliced after the core stack and profile-excluded middleware filtered out.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/graph.py#L815-L892",
          "version": "repo-lines-v1:sha256:e7293f618327a257610429542f35bc59d0d20775a23f8732a10c302c284f05a4:"
        }
      ]
    },
    {
      "id": "claim_eeabd4e80a764b13ae087350abce38db",
      "statement": "FilesystemMiddleware and SubAgentMiddleware are protected scaffolding that a harness profile's excluded_middleware cannot strip; excluding them raises ValueError rather than producing a silently degraded agent.",
