    },
    {
      "id": "claim_3d48ba3fc0134c7a9ebcf837ed19567c",
      "statement": "dcode resolves sandbox providers with configuration over entry point over built-in precedence, validates snapshot use before acquisition, and deletes only resources that its factory created.",
