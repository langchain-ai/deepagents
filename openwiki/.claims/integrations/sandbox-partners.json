    {
      "id": "claim_6c2f68cb7c7247639add83f34d841451",
      "statement": "QuickJS persistence modes differ at reset scope: thread mode snapshots an allocated REPL at run end before eviction, turn mode evicts without persistence, and call mode replaces only the REPL context after each eval while retaining its slot worker and runtime until final eviction.",
      "evidence": [
        {
          "resource": "repo://libs/partners/quickjs/langchain_quickjs/middleware.py#L396-L437",
          "version": "repo-lines-v1:sha256:4b391350a830cac419be1bd9d6da278f48c421dca8f5e35346b3466924da64b6:"
