    {
      "id": "claim_d5f0cd3cc3d64996b26d2e3d6ee0d6a1",
      "statement": "Talon is experimental, and scheduled cron invocations are unattended: the host invokes them without approval or authorization handlers, while the runtime auto-rejects approval interrupts for requests marked `trigger: \"cron\"`.",
