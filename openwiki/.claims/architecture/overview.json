        }
      ]
    },
    {
      "id": "claim_a6ec9756ab004ab9a00b002c024b1ebc",
      "statement": "Deep Agents extends LangChain's AgentState with DeepAgentState, whose messages field uses a DeltaChannel reducer so checkpoint growth stays linear (O(N)) rather than quadratic (O(N^2)) on long threads.",
      "evidence": [
        {
          "resource": "repo://libs/ARCHITECTURE.md#L89-L91",
          "version": "repo-lines-v1:sha256:9d2d24fb090bd6ee2f9dd94ce0c66285bc90038bbef5b6a46e9eab4c71013f0f:"
