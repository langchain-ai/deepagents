    {
      "id": "claim_db7374af1695465a836c2566f7fe7642",
      "statement": "prompt streams the Deep Agent with astream using stream_mode=[\"messages\",\"updates\"] and subgraphs=True, looping while the graph reports interrupts and resuming it via Command(resume=...) with the collected user decisions.",
