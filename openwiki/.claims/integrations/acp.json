  "claims": [
    {
      "id": "claim_6866da08720144d4b5307448f4a9accf",
      "statement": "The deepagents-acp package provides a connector that runs a Python Deep Agent as an Agent Client Protocol (ACP) server, letting ACP-capable editors like Zed drive the agent over stdio.",
      "evidence": [
        {
          "resource": "repo://libs/acp/README.md#L1-L11",
          "version": "repo-lines-v1:sha256:da57bf75cd5900670a9f42365b9809ef41253fc6af47a6feedf6594395ccbc55:"
        },
        {
          "resource": "repo://libs/acp/deepagents_acp/server.py#L164-L166",
          "version": "repo-lines-v1:sha256:9982dd89ab9641f05a35bc5810160c4510e83e03c6704298b5db7445ba660250:"
        }
      ]
    },
    {
      "id": "claim_34a9f2666e724a5487346f4e00e78167",
      "statement": "AgentServerACP subclasses the ACP Agent interface and bridges a LangGraph Deep Agent to the protocol, accepting either a compiled state graph or a per-session factory that builds one from an AgentSessionContext.",
      "evidence": [
        {
          "resource": "repo://libs/acp/deepagents_acp/server.py#L155-L161",
          "version": "repo-lines-v1:sha256:cd0b4464e2c356aa2a7f6882424cea94b53ab4465e9106c7b04a127b29079749:"
