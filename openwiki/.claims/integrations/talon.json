        {
          "resource": "repo://libs/talon/deepagents_talon/host.py#L918-L935",
          "version": "repo-lines-v1:sha256:1496427c08bc3d7a7619219328cbfd9d8f73139d3fab1f2f1dfd5bb8810fb00f:"
