    {
      "id": "claim_c88997f8bbb1497a8d94adaa863a936f",
      "statement": "Sandbox backends provide execution isolation by running model-controlled shell commands inside an isolated provider environment, in contrast to LocalShellBackend which runs commands directly on the host via subprocess.run(shell=True) with no sandboxing and access to any host path.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/backends/local_shell.py#L27-L67",
          "version": "repo-lines-v1:sha256:baf3e8416a64b89b6d03f08980f1d847503512015b17d8fd8c6d462d9bbd72fb:"
