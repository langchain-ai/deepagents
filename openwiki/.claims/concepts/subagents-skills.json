      "id": "claim_6bdfb8742f1343cf8ba28d8db535656f",
      "statement": "Talon's `BackgroundSubagents` detaches local `task` and remote `start_async_task` calls for ordinary conversational turns into owner-scoped in-memory jobs, blocks nested delegation and approvals in workers, enforces job and concurrency limits, and exposes only a bounded text result to the owning conversation.",
      "evidence": [
        {
          "resource": "repo://libs/talon/deepagents_talon/background.py",
          "version": "repo-file-v1:sha256:ebf21e43a62484b40431357fafb08835e22200d0768ba7472c2942fee79fb210"
        },
        {
