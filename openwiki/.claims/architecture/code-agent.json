    {
      "id": "claim_ad8b1e10dc2344529de43764263031a1",
      "statement": "Configuration files are read into a single process-wide generation built on first read and reused; readers resolving through the shared resolver all observe that one generation and cannot disagree, an in-flight edit to config.toml has no effect until the generation advances via an in-app write to the default path or /reload, and each source retains its last usable snapshot so a parse failure leaves that tier unchanged.",
      "evidence": [
        {
          "resource": "repo://libs/code/ARCHITECTURE.md#L44-L50",
          "version": "repo-lines-v1:sha256:b178902bd81c3215d0a5910e7eb8e6c54a7ec4165773ae8597758bef0ab655cc:"
        }
      ]
    },
    {
      "id": "claim_41d5773debd84d199442338f042699bb",
      "statement": "The app does not watch config files for edits because a partly applied configuration is a worse failure than a stale one, and the environment tier is always live because the process mutates os.environ during dotenv bootstrap and on each cwd switch.",
      "evidence": [
