    {
      "id": "claim_9b577faaad1344b3b39669ae32d672d9",
      "statement": "All backend implementations conform to a single uniform interface, BackendProtocol, an abstract base whose file operations default to NotImplementedError so a backend can implement any subset.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/backends/protocol.py#L404-L448",
          "version": "repo-lines-v1:sha256:926e280a83986219a008815c1827fed2b1289330137f2468483a51da169979f9:"
        }
      ]
    },
    {
      "id": "claim_fa8db24ee2ba445f98371587cb00d3e4",
      "statement": "Backend file tools are not thin wrappers around execute: they enforce literal-only (non-regex) matching, return structured GrepResult/GlobResult objects, support max_count truncation, and honor filesystem permission rules.",
