  "claims": [
    {
      "id": "claim_024e49cf6afc421db449060dfd62abf6",
      "statement": "TalonHost is a long-running host for a single assistant that owns and jointly starts/stops the agent runtime, channel adapters, and an optional cron scheduler in one asyncio event loop.",
      "evidence": [
        {
          "resource": "repo://libs/talon/README.md#L1-L15",
          "version": "repo-lines-v1:sha256:e0e01613457f58374fef4f89a836a4de341ee10655e5533345e0e14ad68b55a0:"
        },
        {
          "resource": "repo://libs/talon/deepagents_talon/host.py#L176-L282",
          "version": "repo-lines-v1:sha256:ad95e3966df9f9949e21d66667fa4edac2cc496aa0cde70f86e965eb9b39c31d:"
        }
      ]
    },
    {
      "id": "claim_6abef4e83b4c46dfbacf745d9aee819f",
      "statement": "Talon is an experimental, alpha-status runtime that ships no production security controls (no complete HITL policy, channel admin gates, sandbox isolation, or multi-tenant boundaries), and channel access must be treated as direct access to the operator's agent, credentials, MCP tools, and local host.",
      "evidence": [
        {
          "resource": "repo://libs/talon/README.md#L5-L7",
          "version": "repo-lines-v1:sha256:90100de62114e9f466b350de332123a0a7079d08399034c47f78f4db8a094369:"
        }
      ]
    },
    {
      "id": "claim_6b550fd9c0004891af1f9cb7b7de8ba6",
      "statement": "The host stops its background loop and cancels all in-flight agent work and pending approval/authorization futures before stopping channels in reverse order, then scheduler and runtime; its stop event is set by request_shutdown or installed signals.",
