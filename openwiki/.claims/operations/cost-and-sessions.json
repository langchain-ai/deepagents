    {
      "id": "claim_8766e596f8da45d8b87d026c97243b7e",
      "statement": "dcode cost estimates are display-only: nothing in the CLI caps spend or gates execution on them, so an incorrect rate only produces an inaccurate number.",
      "evidence": [
        {
          "resource": "repo://libs/code/PRICING.md#L9-L10",
          "version": "repo-lines-v1:sha256:383eccdb8fffa473457fddad397cebc07a14a4cb8cd98ef685d1849af363f53e:"
        }
      ]
    },
    {
      "id": "claim_d0f669eb9acc458dbd53fe94bd653cc0",
      "statement": "The graph owns the durable per-thread cumulative cost total in the schema-private CostState channel `_session_cost_usd`, which uses an additive reducer (operator.add) so each write contributes only the spend it priced without read-modify-writing the running total.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/cost_tracking.py#L2192-L2202",
          "version": "repo-lines-v1:sha256:4a64495ccdf5b4456da53887a577264d073fa90f8b658783bb9fa4f7e01e8d9b:"
        }
      ]
    },
    {
      "id": "claim_5dc23cf38d574e9d810dc78d8c488c14",
      "statement": "`_SessionCostRecorder` is a LangChain callback handler installed process-wide for every model request (via `_install_recorder`) that collects one record per completed request keyed by thread and does no pricing, so agent, subagent, offload/summarization, and Auto-classifier calls are all covered with no extra wiring.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/cost_tracking.py#L13-L19",
          "version": "repo-lines-v1:sha256:2616799990c6a0da8fad3c11fc6dbf32f5cdded92ae17dca65b4eba547065d17:"
