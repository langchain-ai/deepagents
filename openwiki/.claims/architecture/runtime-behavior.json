    {
      "id": "claim_40b27e72b5c8466491476f2b545b4c2e",
      "statement": "Server runtime construction returns the compiled agent, its CompositeBackend, and an offload operation derived from that same backend; process construction is lock-protected and cached, while workspace runtimes are a lock-protected LRU of at most 32 entries that reject configuration-policy drift and prevent a process-wide sandbox from being shared by different workspaces.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/server_graph.py",
          "version": "repo-file-v1:sha256:b203832237ff9474747f23804e335535e8fc1a2d3e498ba246f131084cb0cc5d"
        }
      ]
    },
