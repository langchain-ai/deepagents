diff --git a/tests/test_libsy_minimal_bindings.py b/tests/test_libsy_minimal_bindings.py
index b3182cd..406fb08 100644
--- a/tests/test_libsy_minimal_bindings.py
+++ b/tests/test_libsy_minimal_bindings.py
@@ -62,0 +63,10 @@ async def test_random_runs_with_a_python_client() -> None:
+async def test_passthrough_runs_its_target() -> None:
+    client = EchoClient("baseline")
+    algorithm = algorithms.passthrough(LlmTarget("baseline", client))
+
+    decisions, response = await algorithm.run(request_body())
+
+    assert decisions == [{"selected_model": "baseline", "reasoning": None}]
+    assert response["model"] == "baseline"
+
+
@@ -110,0 +121,45 @@ async def test_classifier_config_accepts_a_prompt_override() -> None:
+async def test_escalation_latches_by_session_after_confirmations() -> None:
+    class JudgeClient(EchoClient):
+        async def call(self, request: dict[str, Any]) -> dict[str, Any]:
+            self.calls.append(request)
+            return {
+                "model": self.model,
+                "outputs": [
+                    {
+                        "role": "assistant",
+                        "content": [
+                            {
+                                "type": "text",
+                                "text": '{"escalate":true,"reason":"stuck"}',
+                            }
+                        ],
+                        "stop_reason": "end_turn",
+                    }
+                ],
+            }
+
+    judge = JudgeClient("judge")
+    weak = EchoClient("weak")
+    strong = EchoClient("strong")
+    algorithm = algorithms.llm_escalation(
+        LlmTarget("judge", judge),
+        LlmTarget("weak", weak),
+        LlmTarget("strong", strong),
+        confirmations=2,
+    )
+    headers = {"x-switchyard-session-id": "trial-1"}
+
+    first = await algorithm.run(request_body(), headers=headers)
+    second = await algorithm.run(request_body(), headers=headers)
+    third = await algorithm.run(request_body(), headers=headers)
+
+    assert [first[1]["model"], second[1]["model"], third[1]["model"]] == [
+        "weak",
+        "strong",
+        "strong",
+    ]
+    assert len(judge.calls) == 2
+    assert len(weak.calls) == 2
+    assert len(strong.calls) == 2
+
+
