  "claims": [
    {
      "id": "claim_89e6e182643149d8bef67924fe4743df",
      "statement": "Partner packages are independently versioned and each owns its environment, `pyproject.toml`, `Makefile`, and tests, rather than being owned by dcode's curated provider registry.",
      "evidence": [
        {
          "resource": "repo://libs/partners/AGENTS.md#L1-L4",
          "version": "repo-lines-v1:sha256:e7e53ba9ca73fd6da3f71724a0daddeb0a56f4eec43be993de20c61c0570a09e:"
        }
      ]
    },
    {
      "id": "claim_5f02a3ce78a04332af86e9ee7c9385d1",
      "statement": "QuickJS is a normal dcode dependency used as in-process JavaScript REPL middleware rather than a registered remote sandbox provider; `CodeInterpreterMiddleware` stores an opaque private slot ID in LangGraph state and exposes an `eval` tool whose default schema advertises no network or real-clock access.",
      "evidence": [
        {
          "resource": "repo://libs/code/pyproject.toml#L62-L68",
          "version": "repo-lines-v1:sha256:9d7906bfe91afe020c750fd3ce5fec382c3f7f61900914e5459d965852973b8b:"
        },
        {
          "resource": "repo://libs/partners/quickjs/langchain_quickjs/middleware.py#L75-L97",
