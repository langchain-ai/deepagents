    {
      "id": "claim_1cfe64c62dd94bdf928836136186968f",
      "statement": "dcode configuration is layered across user, project, session, and runtime scopes so teams can share project defaults while individual users keep their own credentials, preferences, skills, and local settings.",
      "evidence": [
        {
          "resource": "repo://libs/code/ARCHITECTURE.md#L40-L44",
