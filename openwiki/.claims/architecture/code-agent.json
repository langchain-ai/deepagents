    {
      "id": "claim_d463e7db72ac47529b1cd7e9f1097352",
      "statement": "deepagents-code (dcode) is a prebuilt terminal coding agent that packages the deepagents SDK harness together with a terminal experience, persistence, tools, skills, and optional sandboxed execution, as a reference implementation.",
      "evidence": [
        {
          "resource": "repo://libs/code/ARCHITECTURE.md#L3-L8",
          "version": "repo-lines-v1:sha256:30e91502f3bcdff1e8318c7dbdb489476294639e59ddf065ac41db963b167bc2:"
        }
      ]
    },
    {
      "id": "claim_1766e25046e44ecbbe4b40892707eb4e",
      "statement": "dcode has two runtime halves that run in separate processes: a terminal client that owns presentation and input (interactive or headless output plus approvals), and an agent server that owns the agent runtime and connects the model, tools, memory, skills, and backend.",
      "evidence": [
        {
          "resource": "repo://libs/code/ARCHITECTURE.md#L11-L26",
          "version": "repo-lines-v1:sha256:4373d0e383f7b91cdc28cd7658e63f653400c091d5a382cef7e4e4d5f715234b:"
        }
      ]
    },
