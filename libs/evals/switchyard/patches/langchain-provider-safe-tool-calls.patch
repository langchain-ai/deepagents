diff --git a/libs/switchyard/langchain_nvidia_switchyard/content_mapper.py b/libs/switchyard/langchain_nvidia_switchyard/content_mapper.py
index 0af1381..ba5b3d6 100644
--- a/libs/switchyard/langchain_nvidia_switchyard/content_mapper.py
+++ b/libs/switchyard/langchain_nvidia_switchyard/content_mapper.py
@@ -6 +6 @@ from collections.abc import Mapping
-from typing import Any
+from typing import Any, cast
@@ -143,0 +144,41 @@ class _ContentMapper:
+
+    @classmethod
+    def ai_message_from_switchyard(
+        cls,
+        content: object,
+        *,
+        path: str,
+        **message_fields: Any,
+    ) -> AIMessage:
+        """Build an `AIMessage` without leaking standard tool blocks to providers.
+
+        LangChain stores tool calls in the dedicated `AIMessage.tool_calls`
+        field. Keeping normalized `tool_call` blocks in `AIMessage.content`
+        causes provider serializers to pass that provider-neutral type through
+        verbatim; Anthropic, for example, accepts `tool_use` but rejects
+        `tool_call`. Non-tool blocks remain ordered in message content, while
+        tool calls stay available through `content_blocks` via LangChain's
+        standard projection.
+
+        Args:
+            content: Switchyard assistant content to translate.
+            path: Validation path used in error messages.
+            **message_fields: Additional fields forwarded to `AIMessage`.
+
+        Returns:
+            A provider-safe LangChain assistant message.
+        """
+        blocks = cls.from_switchyard(
+            content,
+            path=path,
+            allow_tool_calls=True,
+        )
+        message_content = [
+            block for block in blocks if block.get("type") != "tool_call"
+        ]
+        tool_calls = [block for block in blocks if block.get("type") == "tool_call"]
+        return AIMessage(
+            content=cast(Any, message_content),
+            tool_calls=cast(Any, tool_calls),
+            **message_fields,
+        )
