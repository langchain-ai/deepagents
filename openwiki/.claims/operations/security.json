    {
      "id": "claim_c93af821259a4f63839ff4073e526b99",
      "statement": "dcode enforces a HITL tool-execution gate (TB2) on side-effecting tools such as execute, write_file, edit_file, web_search, fetch_url, task, and compaction/async-subagent tools; non-interactive mode substitutes a shell allow-list, and auto_approve bypasses approval prompts while still displaying Unicode/URL warnings.",
      "evidence": [
