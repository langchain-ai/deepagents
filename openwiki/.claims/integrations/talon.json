    {
      "id": "claim_024e49cf6afc421db449060dfd62abf6",
      "statement": "TalonHost is a long-running host for a single assistant that owns and jointly starts/stops the agent runtime, channel adapters, and an optional cron scheduler in one asyncio event loop.",
      "evidence": [
        {
          "resource": "repo://libs/talon/README.md#L1-L15",
          "version": "repo-lines-v1:sha256:e0e01613457f58374fef4f89a836a4de341ee10655e5533345e0e14ad68b55a0:"
