    {
      "id": "claim_f05881a2d99d4895874dc0d877db0121",
      "statement": "`RemoteAgent` caches server-validated workspace descriptors per thread, requires an explicitly configured workspace before binding, and changes its active cwd and cache only after a workspace-switch request succeeds.",
