    {
      "id": "claim_1886f62d4cfc463b902d1813fe24a956",
      "statement": "The ranked config resolver selects a value by precedence in which lower numeric ranks win, ordered managed policy, command-line arguments, process environment, user config.toml, and typed manifest defaults.",
