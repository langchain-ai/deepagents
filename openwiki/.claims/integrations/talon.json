          "version": "repo-lines-v1:sha256:0a53e1899cdea8bb02786ac15d1e6262f9f8701b5cfdebc1101bc59055d38cf7:"
        }
      ]
    },
    {
      "id": "claim_b6b24d115e084a1f8e89ba114e35ae6b",
      "statement": "The host prepares a normal turn by optionally transcribing voice, staging inbound media, building model content, and constructing host-owned request metadata; it supplies optional approval, authorization, progress, breakout, model, and effort fields in `AgentRequest`.",
