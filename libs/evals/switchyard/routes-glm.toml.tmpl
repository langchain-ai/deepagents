# Arm 1 — GLM 5.2 alone. Baseline, measured through Switchyard so its
# /v1/stats numbers are directly comparable to the routed arm.
#
# Route id is "switchyard": every arm exposes the same client-facing model id,
# so only this file changes between runs — the pytest command stays identical.

schema_version = 1

[llm_clients.weak_upstream]
format = "openai_chat"
base_url = "${SY_WEAK_BASE_URL}"
api_key_env = "${SY_WEAK_KEY_ENV}"

[targets.weak]
id = "${SY_WEAK_ID}"
llm_client = "weak_upstream"

[routes.switchyard]
id = "switchyard"
type = "passthrough"
target = "weak"
