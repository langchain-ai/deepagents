    {
      "id": "claim_514aac6e2aee4074936b56bf8d2aa364",
      "statement": "The effective dcode model-node retry budget is selected in descending precedence from --max-retries, provider-specific retry configuration, global retry configuration, and the built-in default; zero disables retries.",
