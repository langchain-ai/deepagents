    {
      "id": "claim_9dd8576f907a4ae6a3aaf99ae316ab30",
      "statement": "The summarization module provides SummarizationMiddleware (automatic threshold-triggered compaction that offloads evicted history to a backend), SummarizationToolMiddleware (an on-demand compact_conversation tool), and the create_summarization_tool_middleware factory.",
