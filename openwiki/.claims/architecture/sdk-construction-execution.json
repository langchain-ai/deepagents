  "claims": [
    {
      "id": "claim_c5dfbd9cde8e41eb8280d713c9d71d4f",
      "statement": "create_deep_agent is the public assembly entry point: it resolves the model and harness profile, selects or creates StateBackend, assembles middleware and subagent policy, and delegates compilation to LangChain create_agent with DeepAgentState unless a schema is supplied.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/graph.py",
          "version": "repo-file-v1:sha256:5964f538571f415331870230b86eae1833f11e52c0d91b38e3c37e6e0c609569"
        }
      ]
    },
    {
      "id": "claim_1adcb986c5814ce682b1ec2dd9a70861",
      "statement": "The main middleware core is FilesystemMiddleware, optional SubAgentMiddleware, _ParentNotifierMiddleware, summarization, PatchToolCallsMiddleware, and optional AsyncSubAgentMiddleware; caller middleware replaces surviving same-name entries or is spliced after that core, exclusions are applied before and after the splice, and excluded-tool filtering is appended last.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/graph.py",
          "version": "repo-file-v1:sha256:5964f538571f415331870230b86eae1833f11e52c0d91b38e3c37e6e0c609569"
        }
      ]
    },
    {
      "id": "claim_fa52c3b43aae4b428a8a9585742f901e",
      "statement": "Declarative subagents are compiled behind the synchronous task tool, receive isolated task messages or forked effective parent history, reject recursive task delegation in fork context, and return only permitted state updates plus a ToolMessage result.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/middleware/subagents.py",
          "version": "repo-file-v1:sha256:66d1a30c8669309a306db73f0ce7376ee9ca1e627e7a4456b57bde7f84fec2e5"
        }
      ]
    },
    {
      "id": "claim_1b5641eb13cc4cf2bfa39ef1de6f6548",
      "statement": "AsyncSubAgentMiddleware exposes start, check, update, cancellation, and list tools for Agent Protocol graphs; launch creates a remote thread and run, then immediately stores a parent-local async task record keyed by that thread ID while the parent continues.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/middleware/async_subagents.py",
          "version": "repo-file-v1:sha256:d04864d71809653355d8c88b1f798b22590a835c3e3d5372cc994d2ab00ba668"
        }
      ]
    },
    {
      "id": "claim_8067f8923a1d4512ad174350c26a8863",
      "statement": "Async subagent fork mode serializes a launch-time snapshot of effective parent history plus the delegated task after removing parent-local artifacts, whereas isolated mode sends only the task; a same-deployment launch may forward JSON-compatible run context, but a URL-targeted remote launch does not, and local ASGI transport without a URL requires asynchronous invocation.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/middleware/async_subagents.py",
          "version": "repo-file-v1:sha256:d04864d71809653355d8c88b1f798b22590a835c3e3d5372cc994d2ab00ba668"
