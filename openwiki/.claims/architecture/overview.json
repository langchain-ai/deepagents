    {
      "id": "claim_02a3292b94514936b7fbbbe869876251",
      "statement": "Deep Agents is a three-layer stack: LangGraph is the runtime (state, checkpoints, streaming, interrupts), LangChain create_agent is the agent abstraction that builds the model-plus-tools-plus-middleware loop on top of LangGraph, and Deep Agents is an opinionated harness on top of create_agent.",
      "evidence": [
        {
          "resource": "repo://README.md#L73-L75",
          "version": "repo-lines-v1:sha256:4c5d8fc25f9a9ca4c46f747b4aaba4dd6544d1b888140f0ee1761f977ee361f5:"
        },
        {
          "resource": "repo://libs/ARCHITECTURE.md#L12-L28",
          "version": "repo-lines-v1:sha256:23398c3df8bf537980a1caa851dd9877a72fd5877a02a8dca483672537d63337:"
        }
      ]
    },
    {
      "id": "claim_cbc6217aff854d20a0bf5f141fb82ae3",
      "statement": "Deep Agents does not introduce a new runtime; create_deep_agent() assembles the default middleware stack and configures backends, subagents, skills, memory, and profiles on top of create_agent().",
      "evidence": [
        {
          "resource": "repo://libs/ARCHITECTURE.md#L26-L30",
          "version": "repo-lines-v1:sha256:549a324dfb8bdc4d4a7e9913a2d220302ed8a47266ca53ef0857411b296ba1ff:"
