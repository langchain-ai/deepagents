{
  "org": "langchain-ai",
  "trustedThreshold": 5,
  "labelColor": "b76e79",
  "sizeThresholds": [
    {
      "label": "size: XS",
      "max": 50
    },
    {
      "label": "size: S",
      "max": 200
    },
    {
      "label": "size: M",
      "max": 500
    },
    {
      "label": "size: L",
      "max": 1000
    },
    {
      "label": "size: XL"
    }
  ],
  "excludedFiles": [
    "uv.lock"
  ],
  "excludedPaths": [
    "docs/"
  ],
  "releaseLabel": "auto:release-pr",
