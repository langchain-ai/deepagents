    {
      "id": "claim_115d42965d5a44968eb1114ec0737927",
      "statement": "The QuickJS `task()` bridge runs configured subagent work through the active outer runtime and enforces a per-REPL concurrent-dispatch semaphore, defaulting to 32; this is not a process-wide or total-dispatch limit.",
