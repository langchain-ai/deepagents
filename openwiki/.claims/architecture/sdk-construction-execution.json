    {
      "id": "claim_c399b6f76b1b4806b54942f95ea0f31f",
      "statement": "create_deep_agent is the single public construction entry point for a Deep Agent; it assembles configuration and delegates the actual graph compilation to LangChain's create_agent() rather than defining a new runtime.",
