  "claims": [
    {
      "id": "claim_8a34c88375f64f23973f8accc0b22d91",
      "statement": "create_deep_agent assembles an ordered list of AgentMiddleware and passes it to LangChain's create_agent(), which builds the actual model/tool loop; the harness adds a new runtime, only middleware.",
