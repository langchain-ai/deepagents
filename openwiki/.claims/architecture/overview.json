    {
      "id": "claim_96b1377ae9274a719f50e9128950aa5b",
      "statement": "LangGraph owns durable execution behavior — graph state carried between steps, checkpoints, streaming, and interrupt-based pause/resume — while LangChain create_agent owns the model/tool/repeat loop shape.",
      "evidence": [
        {
          "resource": "repo://libs/ARCHITECTURE.md#L22-L25",
