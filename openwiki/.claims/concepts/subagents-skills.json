        }
      ]
    },
    {
      "id": "claim_ef4bbe4985d0495dbed08d38b5dbc68a",
      "statement": "Experimental `mode=\"fork\"` reconstructs the parent's effective history and prompt context for a delegated task but forbids an independent skills list and refuses nested `task` calls, preventing recursive delegation.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/graph.py",
