    {
      "id": "claim_5acf32f81a9a46dba1aa132ede1591ce",
      "statement": "RubricMiddleware invokes a separate grader sub-agent each time the agent would otherwise finish; a needs_revision verdict injects feedback as a HumanMessage and resumes the loop, repeating until satisfied, failed, or max_iterations is reached.",
