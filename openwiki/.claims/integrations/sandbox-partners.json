    {
      "id": "claim_813c619149484447aeb87872cd9153f0",
      "statement": "QuickJS prepares PTC bindings and prompt documentation from each current model request's tool list after upstream filtering, caches them by private slot ID, excludes its own eval tool, and conditionally adds subagent guidance only when a current task tool is available and subagents are enabled.",
