    {
      "id": "claim_cb132eda6c544557aa05d00448fd3690",
      "statement": "Unless the harness profile disables it or the caller already supplied a subagent named general-purpose, create_deep_agent builds a default general-purpose synchronous subagent and inserts it at the front of the inline subagent list.",
