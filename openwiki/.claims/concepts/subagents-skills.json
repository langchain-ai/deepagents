    {
      "id": "claim_06a2b19774ec47c5a0d7adc1413d63a1",
      "statement": "At execution time, `SkillsMiddleware` admits an otherwise unregistered skill tool only when the latest disclosure record maps its name to an include name and the resolver still returns it; unrecorded, same-turn, or stale-resolution calls remain invalid-tool errors.",
      "evidence": [
