    },
    {
      "id": "claim_3c33b29e71a742c78802438bdb43c6b8",
      "statement": "Configuration tiers are realized as ranked providers where lower numeric ranks win: managed policy (200), CLI arguments (300), retained runtime-reload values (350), environment (400), user config.toml (500), and manifest defaults (1000).",
