    {
      "id": "claim_71aa05f7b50d42bebbdc1e48bd94e2cd",
      "statement": "The built-in filesystem tool names are fixed by the FsToolName literal: ls, read_file, write_file, edit_file, delete, glob, grep, and execute.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/_constants.py#L16-L28",
