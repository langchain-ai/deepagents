    {
      "id": "claim_57467a4a05b54e5ea875422c516c790b",
      "statement": "resolve_model normalizes its argument into a BaseChatModel: a BaseChatModel instance is returned unchanged, while a string spec is built via init_chat_model composed with kwargs from apply_provider_profile(model), so provider-profile construction tuning only applies to string specs.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/_models.py#L35-L57",
          "version": "repo-lines-v1:sha256:c9ae368330be123fcaa46f04718dc10c2a5d32a602d356f41fc46135f96b35fa:"
        }
      ]
    },
    {
      "id": "claim_6f6546b40bc64c368233653ec3adf7a6",
      "statement": "apply_provider_profile composes lookup, pre_init invocation, and kwargs merging: it returns a fresh dict combining init_kwargs, init_kwargs_factory() output, and caller-supplied kwargs, with the factory winning over static kwargs and caller kwargs winning over both; when no profile matches it returns the caller kwargs unchanged.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/profiles/provider/provider_profiles.py#L318-L381",
          "version": "repo-lines-v1:sha256:f50765dc95f80f2dc55ae8eeea91c04266dca52a4b65ffc9b077c94a5ae0c760:"
        }
      ]
    },
    {
      "id": "claim_6bc656fb4c184131b4237bc7db863d30",
      "statement": "Profile lookup resolves a spec by exact match first, then provider prefix, then None; when both an exact-model and a provider-level profile exist they are merged with the exact-model entry overriding, and malformed specs (empty, multiple colons, or an empty half) return None without consulting the registry.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/profiles/harness/harness_profiles.py#L1050-L1103",
          "version": "repo-lines-v1:sha256:8aa31319cded98b47a06b1b80f96bf952d611789046a1bc05d53aa098d8c23e0:"
