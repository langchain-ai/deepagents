    {
      "id": "claim_3748cc5f2e584ab3ac271a270b94ece8",
      "statement": "SkillsMiddleware implements Anthropic's agent skills pattern with progressive disclosure, loading skills from one or more backend sources (later sources overriding earlier by name) and injecting instructions into the system prompt using backend APIs only.",
