    {
      "id": "claim_d02cdaa2d27b48fdb74b8ca50e36ddf2",
      "statement": "The main-agent middleware stack is assembled in a fixed core order (optional Skills, Filesystem, SubAgent when inline subagents exist, summarization, PatchToolCalls, optional AsyncSubAgent), then a tail (profile extra middleware, prompt caching, optional Memory, optional HumanInTheLoop, and UnsupportedContent) is appended; caller middleware is spliced after the core stack, profile-excluded middleware is filtered out, and tool exclusion is appended last when configured.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/graph.py#L863-L941",
          "version": "repo-lines-v1:sha256:5c5e8a9bb0ea52e0f4b1b08804a5e9995287e26c045b5fe190b570c701d70afa:"
        }
      ]
    },
    {
      "id": "claim_eeabd4e80a764b13ae087350abce38db",
      "statement": "FilesystemMiddleware and SubAgentMiddleware are protected scaffolding that a harness profile's excluded_middleware cannot strip; excluding them raises ValueError rather than producing a silently degraded agent.",
