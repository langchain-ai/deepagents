  "claims": [
    {
      "id": "claim_c1bcef93ead549af8695d7b34f935f02",
      "statement": "Both the SDK and dcode threat models place LLM behavior (model outputs, jailbreaks, model selection) explicitly out of scope, encoding a 'trust the LLM, enforce at the tool/sandbox level' model rather than attempting to make model output safe.",
      "evidence": [
        {
          "resource": "repo://libs/code/THREAT_MODEL.md#L41-L43",
          "version": "repo-lines-v1:sha256:38789afa5a613e048916b1680615f8643d428d0d9a5987fbd3a46154c0021c7b:"
        },
        {
