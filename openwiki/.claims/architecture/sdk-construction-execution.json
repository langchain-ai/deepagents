    {
      "id": "claim_ed8e50ade1a34a39b56fdfb3f51ff98f",
      "statement": "During execution LangGraph drives a per-turn loop in which the model receives the system prompt, message history, and middleware-produced tool surface, then either returns a final response or requests tool calls whose results are appended to state, repeating until no further tool calls are requested.",
      "evidence": [
        {
          "resource": "repo://libs/ARCHITECTURE.md#L49-L61",
          "version": "repo-lines-v1:sha256:eaa0a6ad646cba9741001814d3bb46e11448b56c36e6c3ec888038e9531aac35:"
        }
      ]
    },
    {
      "id": "claim_2c52c639c39248fb9d381225b2bacc5f",
      "statement": "Deep Agents shapes the execution loop through middleware (which can alter the tool list and prompt, summarize or offload history, write typed state, and enforce filesystem permissions before a model call or tool run) rather than through plain tool callables, which only run after the model chooses to call them and cannot rewrite the request beforehand.",
      "evidence": [
        {
          "resource": "repo://libs/ARCHITECTURE.md#L53-L61",
          "version": "repo-lines-v1:sha256:0b96df626b2e146b1874762f4234a480a0032e64d656cac5d282913c3866647e:"
