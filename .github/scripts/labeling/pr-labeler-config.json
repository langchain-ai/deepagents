{
  "org": "langchain-ai",
  "trustedThreshold": 5,
  "labelColor": "b76e79",
  "sizeThresholds": [
    {
      "label": "size: XS",
      "max": 50
    },
    {
      "label": "size: S",
      "max": 200
    },
    {
      "label": "size: M",
      "max": 500
    },
    {
      "label": "size: L",
      "max": 1000
    },
    {
      "label": "size: XL"
    }
  ],
  "excludedFiles": [
    "uv.lock"
  ],
  "excludedPaths": [
    "docs/"
  ],
  "releaseLabel": "auto:release-pr",
  "typeToLabel": {
    "feat": "type:feature",
    "fix": "type:bug",
    "docs": "type:docs",
    "hotfix": "type:hotfix",
    "style": "type:style",
    "refactor": "type:refactor",
    "perf": "type:performance",
    "test": "type:test",
    "build": "type:build",
    "ci": "type:ci",
    "chore": "type:chore",
    "revert": "type:revert"
  },
  "breakingLabel": "type:breaking",
  "labelDescriptions": {
    "type:feature": "A new feature or enhancement.",
    "type:bug": "A bug report or bug fix.",
    "type:docs": "Documentation changes or requests.",
    "type:hotfix": "An urgent fix using the manual release path.",
    "type:style": "Formatting or style changes without behavior changes.",
    "type:refactor": "Code restructuring without a feature or bug fix.",
    "type:performance": "Performance improvements.",
    "type:test": "New or updated tests.",
    "type:build": "Changes to the build system or external dependencies.",
    "type:ci": "Changes to continuous integration workflows.",
    "type:chore": "Maintenance work.",
    "type:revert": "Reverts a previous change.",
    "type:breaking": "The PR title declares a breaking change with !."
  },
  "scopeToLabel": {
    "acp": "package:acp",
    "code": "package:dcode",
    "daytona": "integration:daytona",
    "deepagents": "package:deepagents",
    "deepagents-acp": "package:acp",
    "deepagents-code": "package:dcode",
    "deepagents-talon": "package:talon",
    "evals": "package:evals",
    "examples": "package:examples",
    "harbor": "package:evals",
    "langchain-daytona": "integration:daytona",
    "langchain-modal": "integration:modal",
    "langchain-quickjs": "integration:quickjs",
    "langchain-runloop": "integration:runloop",
    "langchain-vercel-sandbox": "integration:vercel",
    "langsmith-sandbox": "integration:langsmith",
    "modal": "integration:modal",
    "quickjs": "integration:quickjs",
    "runloop": "integration:runloop",
    "sdk": "package:deepagents",
    "talon": "package:talon",
    "vercel": "integration:vercel"
  },
  "scopeAliases": {
    "deepagents": "sdk",
    "deepagents-acp": "acp",
    "deepagents-code": "code",
    "deepagents-talon": "talon"
  },
  "branchRules": [
    {
      "label": "org:open-swe",
      "prefix": "open-swe/"
    }
  ],
  "fileRules": [
    {
      "label": "package:deepagents",
      "prefix": "libs/deepagents/",
      "skipExcludedFiles": true
    },
    {
      "label": "package:acp",
      "prefix": "libs/acp/",
      "skipExcludedFiles": true
    },
    {
      "label": "package:dcode",
      "prefix": "libs/code/",
      "skipExcludedFiles": true
    },
    {
      "label": "package:talon",
      "prefix": "libs/talon/",
      "skipExcludedFiles": true
    },
    {
      "label": "package:evals",
      "prefix": "libs/evals/",
      "skipExcludedFiles": true
    },
    {
      "label": "package:evals",
      "prefix": "libs/harbor/",
      "skipExcludedFiles": true
    },
    {
      "label": "package:examples",
      "prefix": "examples/",
      "skipExcludedFiles": true
    },
    {
      "label": "integration:daytona",
      "prefix": "libs/partners/daytona/",
      "skipExcludedFiles": true
    },
    {
      "label": "integration:modal",
      "prefix": "libs/partners/modal/",
      "skipExcludedFiles": true
    },
    {
      "label": "integration:quickjs",
      "prefix": "libs/partners/quickjs/",
      "skipExcludedFiles": true
    },
    {
      "label": "integration:runloop",
      "prefix": "libs/partners/runloop/",
      "skipExcludedFiles": true
    },
    {
      "label": "integration:vercel",
      "prefix": "libs/partners/vercel/",
      "skipExcludedFiles": true
    }
  ]
}
