    {
      "id": "claim_96f6659d6f8a4820a7869763500e9f3a",
      "statement": "FilesystemMiddleware evicts a large tool result by writing its text to `{large_tool_results_prefix}/{sanitized_tool_call_id}` on the backend and replacing the ToolMessage with a TOO_LARGE_TOOL_MSG head+tail preview that instructs recovery via read_file with offset/limit; if the backend write fails the original message is kept.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/middleware/_message_eviction.py",
          "version": "repo-file-v1:sha256:ec529779bf748ae6fc50dd0c7860ce4d2d31e305faad998b4f3a123ff66b3db2"
        }
      ]
    },
    {
      "id": "claim_ddf8f81e6a8a4810bb8409af9600c050",
      "statement": "SummarizationMiddleware.wrap_model_call compacts history by truncating over-long tool args, checking `_should_summarize` against the configured trigger, and when triggered partitioning messages at `_determine_cutoff_index`, offloading pre-summary history, generating an LLM summary, and returning a summary message plus the preserved tail with a Command state update.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/middleware/summarization.py",
          "version": "repo-file-v1:sha256:0f0dcc030acb348bf2d00e88f61e0151e073f403936eb4c32c443000b9b37218"
        }
