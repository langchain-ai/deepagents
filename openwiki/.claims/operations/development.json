    {
      "id": "claim_be5cd56c3eeb4c2fa830fe65afeb7bca",
      "statement": "The lockfile refresh helper computes changed manifest owners plus their reverse transitive local-source consumers and runs `uv lock` with each package’s selected Python version; the ordinary checker instead checks directly touched packages, or every discovered package when invoked without paths, and reports a concrete repair command for an out-of-date lock.",
      "evidence": [
        {
          "resource": "repo://.github/scripts/checks/check_lockfiles_pre_commit.py",
          "version": "repo-file-v1:sha256:06179e3332dbee392bde04770570c2d75e59d62877bfce07c7d642de87cfa213"
