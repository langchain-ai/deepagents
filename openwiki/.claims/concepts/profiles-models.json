    },
    {
      "id": "claim_9e19b0c0d5144b31b9b4e2dffcea9075",
      "statement": "Harness middleware exclusions cannot remove required filesystem or subagent scaffolding, and unmatched exclusions fail graph assembly; tool exclusions instead run after tool-injecting and custom middleware, making them the supported way to hide tools from the model.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/profiles/harness/harness_profiles.py",
          "version": "repo-file-v1:sha256:ffe76d57768c722ca729918ddfd1c60646159b9ca9b916cb4916b3ddde194653"
