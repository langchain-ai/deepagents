    {
      "id": "claim_95c92ea73e8e4bfe8801ed3e4a080237",
      "statement": "Local package dependencies are wired as editable uv sources, so changes in a dependency package are immediately visible to sibling packages during development (e.g. libs/code declares deepagents, deepagents-acp, and every partner package with editable = true).",
