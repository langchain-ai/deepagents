    },
    {
      "id": "claim_3598a8ba684940e99c0c6d4c61616003",
      "statement": "The prompt handler converts inbound ACP content blocks (text, image, audio, resource, embedded resource) into LangChain multimodal content before running the agent.",
      "evidence": [
        {
          "resource": "repo://libs/acp/deepagents_acp/server.py#L919-L935",
