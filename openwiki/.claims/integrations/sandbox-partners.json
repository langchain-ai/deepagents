  "claims": [
    {
      "id": "claim_ac9d07f5c6064ef7a2a64d3bca27ae9e",
      "statement": "SandboxBackendProtocol extends the generic BackendProtocol by adding shell command execution via execute()/aexecute() plus an id property, and is intended for backends running in isolated environments such as containers, VMs, or remote hosts.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/backends/protocol.py#L870-L910",
          "version": "repo-lines-v1:sha256:ca7bf3b376919f5819d0f2ddbd2ac2fffb9d3af8d9b82aceaa243fbbcb08e302:"
        }
      ]
    },
    {
      "id": "claim_d8163ea28099414d84294da72ad24927",
      "statement": "The execute() primitive takes a full shell command string and optional timeout and returns an ExecuteResponse carrying combined output, an exit_code, and a truncated flag; the default aexecute() runs execute() on a worker thread via asyncio.to_thread and forwards timeout only when the concrete backend accepts it.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/backends/protocol.py#L887-L925",
          "version": "repo-lines-v1:sha256:26d33556209f939d0a48fd4d15cc897c4250c9f958291be44016e4a237d5281f:"
        },
        {
          "resource": "repo://libs/deepagents/deepagents/backends/sandbox.py#L1445-L1462",
          "version": "repo-lines-v1:sha256:efbc248b72e54bd1596f6657e59b40eef5d67b45a819214d235c0ef34d9dca6f:"
        }
      ]
    },
    {
      "id": "claim_eeb8eb662b6a4ab7a3e09ebc86824aa4",
      "statement": "The agent's execute tool runs shell commands only when the configured backend implements SandboxBackendProtocol; for non-sandbox backends the execute tool returns an error message instead.",
