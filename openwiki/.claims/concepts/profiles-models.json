        }
      ]
    },
    {
      "id": "claim_6c21a984544241498422af414bbe3400",
      "statement": "Harness profiles can tune every SDK-assembled main, general-purpose, and declarative synchronous subagent stack through static or factory extra middleware, but cannot inject into already compiled or remote async subagents; file-friendly HarnessProfileConfig deliberately excludes this runtime-only extension.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/profiles/harness/harness_profiles.py",
          "version": "repo-file-v1:sha256:ffe76d57768c722ca729918ddfd1c60646159b9ca9b916cb4916b3ddde194653"
        }
