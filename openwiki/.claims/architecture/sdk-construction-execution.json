    {
      "id": "claim_d02cdaa2d27b48fdb74b8ca50e36ddf2",
      "statement": "The main-agent middleware stack has a fixed core order of Filesystem, optional SubAgent, summarization, PatchToolCalls, and optional AsyncSubAgent; its tail is profile extra middleware, optional Skills, prompt caching, optional Memory, optional HumanInTheLoop, and UnsupportedContent. Caller middleware replaces matching names or is inserted after the core, exclusions are applied before and after that splice, and tool exclusion is appended last.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/graph.py#L879-L960",
