        {
          "resource": "repo://libs/code/deepagents_code/configuration/resolver.py#L32-L48",
          "version": "repo-lines-v1:sha256:fbe0a4008adf5b430f6db49a2f9ad20dae78ac8bcdbbd30bdfd3090bec33562e:"
        }
      ]
    },
    {
      "id": "claim_a53b9270951b4ef8b810775ae04c0849",
      "statement": "The process environment tier (rank 400) has stronger precedence than the user config.toml tier (rank 500), so an environment variable overrides a value written in the user file.",
