        }
      ]
    },
    {
      "id": "claim_6e39dd07d1304f1a9a9a405a4a3bb0f0",
      "statement": "The deepagents SDK provides no OS-level process isolation; users needing isolation for untrusted workloads are expected to extend BaseSandbox or use container/VM-level sandboxing, making sandbox backends the primary containment mechanism.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/THREAT_MODEL.md#L32-L32",
          "version": "repo-lines-v1:sha256:698ea84032c22271aed1bbd4d2ef310f8de8a5fd8bceeda41548b8be5463b7db:"
        }
      ]
    },
    {
      "id": "claim_99e1e1e43c3f4caa8900bc37c5d21882",
      "statement": "The default StateBackend keeps files in ephemeral LangGraph state while the opt-in LocalShellBackend runs unrestricted subprocess.run(shell=True) with full host access regardless of virtual_mode, so containment depends on which backend executes tools, not on the tool implementations.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/THREAT_MODEL.md#L129-L131",
          "version": "repo-lines-v1:sha256:3baf6675b9024ab768a7d220fd26f51e9bee36082e2bcdb51fd1ad0c7f5b93e3:"
