    {
      "id": "claim_ac9d07f5c6064ef7a2a64d3bca27ae9e",
      "statement": "SandboxBackendProtocol extends the generic BackendProtocol by adding shell command execution via execute()/aexecute() plus an id property, and is intended for backends running in isolated environments such as containers, VMs, or remote hosts.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/backends/protocol.py#L870-L925",
          "version": "repo-lines-v1:sha256:d932d8ff369664b783dc63885d1c58f4dfbbfd867371840a46159124067ae74a:"
        }
      ]
    },
    {
      "id": "claim_d0c5dece75d446e3917e298a87d75eef",
      "statement": "BaseSandbox implements SandboxBackendProtocol and derives all file operations from a small set of subclass-provided primitives: concrete subclasses implement only execute(), upload_files(), download_files(), and the id property.",
      "evidence": [
        {
