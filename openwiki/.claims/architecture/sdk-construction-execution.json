    {
      "id": "claim_ed8e50ade1a34a39b56fdfb3f51ff98f",
      "statement": "During execution LangGraph drives a per-turn loop in which the model receives the system prompt, message history, and middleware-produced tool surface, then either returns a final response or requests tool calls whose results are appended to state, repeating until no further tool calls are requested.",
      "evidence": [
        {
          "resource": "repo://libs/ARCHITECTURE.md#L49-L61",
