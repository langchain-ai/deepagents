    {
      "id": "claim_a64f733f2f92431a84333168dbfe4826",
      "statement": "The repository is a monorepo of independently versioned Python packages under libs/ with no root pyproject.toml; each package owns its own pyproject.toml, Makefile, and README.md, and contributors work inside the single package they are changing.",
      "evidence": [
        {
          "resource": "repo://libs/DEVELOPMENT.md#L30-L49",
          "version": "repo-lines-v1:sha256:7fadcab0884d15474b9ffc94632e833e341967e49cdc798b113d09d8d854a6f2:"
        }
      ]
