    {
      "id": "claim_5e28e67e1f5a448687cb1d0cfd94b597",
      "statement": "Managed policy is the strongest tier and the trust root; resolver_from_snapshots is keyword-only so a positional transposition cannot load the writable user file at the managed rank and grant user data managed precedence.",
