          "resource": "repo://libs/deepagents/deepagents/middleware/filesystem.py#L1738-L1768",
          "version": "repo-lines-v1:sha256:e269fbe89d9182e8f85ece3af28cadfb01687e70941693450db38d7e7f0b7ea4:"
        }
