        {
          "resource": "repo://libs/code/deepagents_code/configuration/resolver.py#L388-L450",
          "version": "repo-lines-v1:sha256:d646effa49b05a6807944b98709e9ebf9eea46910c9ab6706788a600c0fa951c:"
