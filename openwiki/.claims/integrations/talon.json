  "claims": [
    {
      "id": "claim_bafa036584d341e8b808fb1e1a86fe09",
      "statement": "`TalonHost` starts the runtime before binding and starting channels and then the scheduler; a failed startup unwinds started components, and shutdown cancels work before stopping channels, scheduler, and runtime while continuing after component-stop failures.",
      "evidence": [
        {
          "resource": "repo://libs/talon/deepagents_talon/host.py#L388-L485",
          "version": "repo-lines-v1:sha256:469683720a136a1b62be7a779717e8428aa87332d3235ac9fca9efbbfa1d6949:"
        }
      ]
    },
    {
      "id": "claim_d0d287136ec2405f8184bb9c0a317a2c",
      "statement": "For each non-help channel message, `TalonHost` holds history and conversation locks, consumes host commands, pending tool-approval replies, and authorization callbacks before starting an agent turn; a normal message replaces the active conversation task and refuses the replacement if cancellation times out.",
      "evidence": [
        {
          "resource": "repo://libs/talon/deepagents_talon/host.py#L502-L557",
          "version": "repo-lines-v1:sha256:6d91dce316e2e817c3cec53ef425e241855b195a1ede24c0fc818fcc0ca895d4:"
        },
        {
