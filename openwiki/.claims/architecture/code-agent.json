    {
      "id": "claim_ecc9ec98b14344b6ba8f3d3b0e9611b7",
      "statement": "dcode caches server-owned resources by lifetime and workspace: the launch runtime is built once under an async lock, while bound executions use workspace runtimes held in an LRU cache of at most 32 under a workspace lock; caching prevents duplicate MCP discovery, sandbox creation, and atexit handler registration for a constructed runtime.",
      "evidence": [
        {
