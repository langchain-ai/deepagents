    {
      "id": "claim_785fe4cdf8cc47119ce9a59ee17b7bf3",
      "statement": "execute_with_offload() captures large command output to a file in the sandbox and returns only a head/tail preview when output exceeds max_inline_bytes, hard-capping captured output at max_capture_bytes without killing the command so the exit code is preserved; the behavior is opt-in via the enable_capture_offload class attribute which defaults to False, and when False the command runs unwrapped and the full output is returned with offloaded=False.",
      "evidence": [
