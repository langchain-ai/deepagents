  "claims": [
    {
      "id": "claim_4018009140e341f487f6f52cdcbd1a24",
      "statement": "The model's visible tool set is assembled from layered sources — built-in middleware tools (filesystem, todo, subagent/task), caller-supplied tools=, backend capability gating, and profile excluded_tools — rather than a single hand-maintained list.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/graph.py#L363-L392",
          "version": "repo-lines-v1:sha256:e87c4c255d81880808b1531b530108f8193c29c33731b0fa5d67c484abb3c812:"
        },
        {
          "resource": "repo://libs/deepagents/deepagents/middleware/filesystem.py#L1755-L1768",
          "version": "repo-lines-v1:sha256:0ddf2f9ffda086f6caf266f4b540c9c3f6bc4b32f98895ae4b89e5c97d6b8d1d:"
        }
      ]
    },
    {
      "id": "claim_f68f3dfd8f864dd4b002adda749c6dbb",
      "statement": "Tool visibility and permission are orthogonal: a tool advertised to and chosen by the model can still be denied, interrupted for human approval, or rejected at the tool-call boundary, so an offered tool is not necessarily an executable one.",
      "evidence": [
        {
          "resource": "repo://libs/deepagents/deepagents/middleware/_tool_exclusion.py#L34-L93",
          "version": "repo-lines-v1:sha256:f10d7f5cd9ffa094b3ffbd312eebda316da8f684c2e9a242bb488494c3f93c33:"
        },
        {
