        {
          "resource": "repo://libs/deepagents/deepagents/graph.py#L293-L299",
          "version": "repo-lines-v1:sha256:2d9361890031f3b80a4845d47d477bd9b8a64a9259ad4157f4ac4a87897d249f:"
        }
      ]
    },
