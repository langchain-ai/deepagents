    {
      "id": "claim_4ca12b1f3fd54872ba573336b929a972",
      "statement": "The dependency direction runs Deep Agents to LangChain create_agent to LangGraph, so each layer depends on the one below it and any LangGraph CompiledStateGraph can be passed in as a Deep Agents sub-agent.",
      "evidence": [
        {
          "resource": "repo://README.md#L85-L89",
