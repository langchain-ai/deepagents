        }
      ]
    },
    {
      "id": "claim_7ce7ccaf2fa6412faab4fe07f8d3609b",
      "statement": "The default DeepAgentState messages channel uses DeltaChannel with the message-delta reducer; the reducer coerces raw inputs, updates or removes messages by ID, honors remove-all, and handles absent replay state as empty.",
