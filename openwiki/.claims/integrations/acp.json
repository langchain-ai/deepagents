        }
      ]
    },
    {
      "id": "claim_30c274e29dbe4e3e8e6687dd3c9a38af",
      "statement": "The modes and models constructor arguments may only be supplied when the agent is a factory; passing either alongside a compiled CompiledStateGraph raises ValueError.",
