    {
      "id": "claim_0a4bc8bfcdc64450b23bd2e08bbe1651",
      "statement": "The client talks to the server over HTTP plus server-sent events via RemoteAgent, a thin wrapper around LangGraph's RemoteGraph that delegates SSE parsing, messages-tuple stream-mode negotiation, namespace extraction, and interrupt detection, and adds streamed message-object conversion for the Textual adapter while leaving state snapshots in the server's serialized form.",
      "evidence": [
        {
          "resource": "repo://libs/code/deepagents_code/client/remote_client.py#L1-L7",
          "version": "repo-lines-v1:sha256:d49f91521d29c7a4468d637b70187d46ec080914eb14ef78efa97556fb583181:"
